{"success":true,"html":"\u003Cdiv class=\u0022content pt-0\u0022\u003E\n    \u003Cdiv class=\u0022card\u0022\u003E\n        \u003Cdiv class=\u0022card-header border-bottom-0 pb-0 d-flex align-items-center justify-content-between\u0022\u003E\n            \u003Ch5 class=\u0022mb-0\u0022\u003E\n                \u0628\u0646\u0643 \u0627\u0644\u0625\u062B\u0631\u0627\u0621\u0627\u062A\n            \u003C/h5\u003E\n            \u003Ca href=\u0022#\u0022 onclick=\u0022openCreationModal(\u0027/LearningResources/MangeResources/Create?schoolId=E7F07D5AB1E7A8BAA59F6FC2BA80190B\u0026isNotUserLayout=True\u0027, \u0027\u0625\u0636\u0627\u0641\u0629 \u0625\u062B\u0631\u0627\u0621\u0027,\u0027#mainView\u0027, \u0027searchActivitesList\u0027);\u0022 class=\u0022btn btn-primary px-lg-3\u0022\u003E\n                \u003Ci class=\u0022fa-regular fa-plus me-2\u0022\u003E\u003C/i\u003E\n                \u0625\u0636\u0627\u0641\u0629 \u0625\u062B\u0631\u0627\u0621\n            \u003C/a\u003E\n        \u003C/div\u003E\n        \u003Cdiv class=\u0022card-body\u0022 id=\u0022divSearchActivitiesContainerId\u0022\u003E\n            \u003Cdiv class=\u0022card border shadow-none\u0022\u003E\n                \u003Cdiv class=\u0022card-body\u0022\u003E\n                    \u003Cdiv class=\u0022row mb-3\u0022\u003E\n                        \n\n\n\u003Cdiv class=\u0022col-md-12 col-sm-12 col-xs-12 form-group required m-t-sm\u0022 id=\u0022div_blockdll\u0022\u003E\n    \u003Clabel for=\u0022selectedUnitId\u0022 class=\u0022form-label fw-semibold\u0022\u003E\u0645\u0633\u0627\u0631 \u0627\u0644\u062F\u0631\u0633\u003C/label\u003E\n    \u003Cdiv class=\u0022col-lg-6 col-md-6 col-sm-12 col-xs-12\u0022\u003E\n        \u003Cselect id=\u0022relatedDataselectedUnitId\u0022 class = \u0022form-control select2\u0022  style = \u0022direction:rtl\u0022  disabled = \u0022disabled\u0022\u003E\n                \u003Coption value=\u0022277\u0022\u003E\u0627\u0644\u0645\u0631\u062D\u0644\u0629 \u0627\u0644\u0627\u0628\u062A\u062F\u0627\u0626\u064A\u0629 - \u0627\u0644\u0635\u0641 \u0627\u0644\u0623\u0648\u0644 \u0627\u0644\u0627\u0628\u062A\u062F\u0627\u0626\u064A - \u0645\u0642\u0631\u0631\u0627\u062A \u0627\u0644\u0639\u0627\u0645 \u0627\u0644\u062F\u0631\u0627\u0633\u064A - \u0627\u0644\u0631\u064A\u0627\u0636\u064A\u0627\u062A\u003C/option\u003E\n        \u003C/select\u003E\n    \u003C/div\u003E\n    \u003Cdiv class=\u0022col-lg-1 col-md-1 col-sm-12 col-xs-12\u0022\u003E\n\n    \u003C/div\u003E\n    \u003Cspan id=\u0022SelectedUnitId_Error\u0022 class=\u0022col-lg-3 col-md-3 col-sm-12 col-xs-12 text-danger\u0022\u003E\n        \u003Cspan class=\u0022field-validation-valid\u0022 data-valmsg-for=\u0022selectedUnitId\u0022 data-valmsg-replace=\u0022true\u0022\u003E\u003C/span\u003E\n    \u003C/span\u003E\n\u003C/div\u003E\n\n\n\u003Cdiv id=\u0022relatedDataTrees\u0022 class=\u0022tree-div\u0022\u003E\n\n            \u003Cdiv id=\u0022levelrelatedData_2\u0022 class=\u0022col-lg-12 col-md-12 col-sm-12 col-xs-12 form-group\u0022\u003E\n                \u003Clabel class=\u0022control-label col-md-2 text-center\u0022\u003E\u003C/label\u003E\n                \u003Cdiv class=\u0022col-lg-6 col-md-6 col-sm-12 col-xs-12\u0022\u003E\n                            \u003Cselect name=\u0022SelectedrelatedDataTrees_2\u0022 id=\u0022\u0022 class=\u0022form-control selectedrelatedDataTrees select2\u0022 style=\u0022direction:rtl\u0022 onchange=\u0022return relatedDataDrawTrees( 2,this.value);\u0022\u003E\n                                    \u003Coption value=\u00224703\u0022 selected\u003E \u0637\u0631\u0627\u0626\u0642 \u0627\u0644\u062C\u0645\u0639 \u0648\u0627\u0644\u0637\u0631\u062D\u003C/option\u003E\n\n                            \u003C/select\u003E\n                \u003C/div\u003E\n                \u003Cdiv class=\u0022col-lg-1 col-md-1 col-sm-12 col-xs-12\u0022\u003E\n\n                \u003C/div\u003E\n                \u003Cspan class=\u0022col-lg-3 col-md-3 col-sm-12 col-xs-12 text-danger\u0022\u003E\u003C/span\u003E\n            \u003C/div\u003E\n            \u003Cdiv id=\u0022levelrelatedData_3\u0022 class=\u0022col-lg-12 col-md-12 col-sm-12 col-xs-12 form-group\u0022\u003E\n                \u003Clabel class=\u0022control-label col-md-2 text-center\u0022\u003E\u003C/label\u003E\n                \u003Cdiv class=\u0022col-lg-6 col-md-6 col-sm-12 col-xs-12\u0022\u003E\n                            \u003Cinput type=\u0022hidden\u0022 id=\u0022userLessonSelected\u0022 /\u003E\n                                \u003Cselect id=\u0022SelectedrelatedDataTrees_3\u0022 name=\u0022SelectedrelatedDataTrees_3\u0022\n                                        class=\u0022form-control selectedrelatedDataTrees relatedDataLesson  select2\u0022 multiple style=\u0022direction: rtl\u0022\u003E\n\n                                            \u003Coption value=\u002227564\u0022 selected\u003E\u0627\u0644\u0637\u0631\u062D \u0628\u0627\u0633\u062A\u0639\u0645\u0627\u0644 \u062E\u0637 \u0627\u0644\u0623\u0639\u062F\u0627\u062F\u003C/option\u003E\n                                \u003C/select\u003E\n                                \u003Cinput id=\u0022userSelectedLesson\u0022 type=\u0022hidden\u0022 value=\u002227564\u0022 /\u003E\n                \u003C/div\u003E\n                \u003Cdiv class=\u0022col-lg-1 col-md-1 col-sm-12 col-xs-12\u0022\u003E\n\n                \u003C/div\u003E\n                \u003Cspan class=\u0022col-lg-3 col-md-3 col-sm-12 col-xs-12 text-danger\u0022\u003E\u003C/span\u003E\n            \u003C/div\u003E\n\u003C/div\u003E\n\n\n\n\u003Cinput id=\u0022hfRelatedDataLevelsCount\u0022 name=\u0022hfRelatedDataLevelsCount\u0022 type=\u0022hidden\u0022 value=\u00223\u0022 /\u003E\n\u003Cinput id=\u0022hfRelatedDataDrawTree\u0022 name=\u0022hfRelatedDataDrawTree\u0022 type=\u0022hidden\u0022 value=\u0022/Teacher/LectureTools/DrawTreeToDroosLesson\u0022 /\u003E\n\n\n    \u003Cscript\u003E\n        $(\u0022.relatedDataLesson\u0022).select2();\n        function relatedDataDrawTrees(level, value) {\n           \n\n            var hfTreeId = 0;\n            var levelsCount = document.getElementById(\u0027hfRelatedDataLevelsCount\u0027).value;\n\n            if (value === \u0022\u0022) {\n                document.getElementById(\u0027hfRelatedDataLevelsCount\u0027).value = level;\n                var cLevel = level \u002B 1;\n                for (var i = cLevel; i \u003C= levelsCount; i\u002B\u002B) {\n                    var elem = document.getElementById(\u0027levelrelatedData_\u0027 \u002B i);\n                    if (elem != null) document.getElementById(\u0027levelrelatedData_\u0027 \u002B i).remove();\n                }\n                $(\u0022#viewItem_\u0022 \u002B level).hide();\n            }\n            else {\n\n                $.ajax({\n                    url: $(\u0022#hfRelatedDataDrawTree\u0022).val(),\n                    type: \u0027GET\u0027,\n                    dataType: \u0027json\u0027,\n                    cache: false,\n                    data: { id: value },\n                    success: function (result) {\n\n                        var cLevel = level \u002B 1;\n                        for (var i = cLevel; i \u003C= levelsCount; i\u002B\u002B) {\n                            var elem = document.getElementById(\u0027levelrelatedData_\u0027 \u002B i);\n                            if (elem != null) document.getElementById(\u0027levelrelatedData_\u0027 \u002B i).remove();\n                        }\n                        relatedDataDrawDropDown(cLevel, result.obj, value);\n                        if ($(\u0027select.CHAPCURR\u0027).length \u0026\u0026 $(\u0027select.CHAPCURR\u0027).val() != \u0027\u0027 \u0026\u0026 $(\u0022#hfLecTreeId\u0022).length) { $(\u0022#hfLecTreeId\u0022).val($(\u0027select.CHAPCURR\u0027).val()); }\n\n                        else if ($(\u0027select.UNITCURR\u0027).length \u0026\u0026 $(\u0027select.UNITCURR\u0027).val() != \u0027\u0027 \u0026\u0026 $(\u0022#hfLecTreeId\u0022).length) { $(\u0022#hfLecTreeId\u0022).val($(\u0027select.UNITCURR\u0027).val()); }\n                    },\n                    beforeSend: function (b, a) {\n                        blockui(\u0022#relatedDataTrees\u0022);\n                    },\n                    complete: function (a, b) {\n                        unblockui(\u0022#relatedDataTrees\u0022);\n\n                    }\n                });\n\n                $(\u0022#viewItem_\u0022 \u002B level).show();\n\n            }\n\n        }\n\n        function LessonIconView(level, value) {\n\n            if (value === \u0022\u0022) {\n                $(\u0022#viewItem_\u0022 \u002B level).hide();\n            } else {\n                $(\u0022#viewItem_\u0022 \u002B level).show();\n            }\n        }\n\n        //relatedDataDrowStages\n\n        function relatedDataDrowStages(value) {\n\n\n            $.ajax({\n                url: $(\u0022#hfDrawStages\u0022).val(),\n                type: \u0027GET\u0027,\n                dataType: \u0027json\u0027,\n                cache: false,\n                data: { schoolId: value },\n                success: function (result) {\n\n                    var stages = document.getElementById(\u0022SelectedStageId\u0022);\n                    var length = stages.options.length;\n                    for (i = 0; i \u003C length; i\u002B\u002B) {\n                        stages.options[i] = null;\n                    }\n\n                    $(stages).append($(\u0022\u003Coption\u003E\u003C/option\u003E\u0022).attr(\u0022value\u0022, \u0022\u0022).text(\u0027\u0627\u062E\u062A\u0631\u0027));\n                    for (i = 0; i \u003C result.length; i\u002B\u002B) {\n                        $(stages).append($(\u0022\u003Coption\u003E\u003C/option\u003E\u0022).attr(\u0022value\u0022, result[i].Id).text(result[i].Title));\n\n                    }\n                },\n                beforeSend: function (b, a) {\n                    blockui(\u0022#relatedDataTrees\u0022);\n                },\n                complete: function (a, b) {\n                    unblockui(\u0022#relatedDataTrees\u0022);\n\n                }\n            });\n\n\n        }\n\n\n        function relatedDataDrawDropDown(level, items, value) {\n\n            if (items.length \u003E 0) {\n\n                document.getElementById(\u0027hfRelatedDataLevelsCount\u0027).value = level;\n\n                    var ddItems = \u0027\u0027;\n                  ddItems \u002B= \u0022\u003Coption value=\u0027\u0027\u003E\u0627\u062E\u062A\u0631\u003C/option\u003E\u0022;\n\n                var isClassRooms = false;\n                var isLesson = false;\n\n                var className = \u0022\u0022;\n\n                for (i = 0; i \u003C items.length; i\u002B\u002B) {\n\n                    if (items[0].CodeType == \u0027LESSON\u0027 \u0026\u0026 i == 0) {\n                        ddItems = \u0027\u0027;\n                    }\n\n\n                    ddItems \u002B= \u0022\u003Coption value=\u0027\u0022 \u002B items[i].Id \u002B \u0022\u0027\u003E\u0022 \u002B items[i].Title \u002B \u0022\u003C/option\u003E\u0022;\n\n                    if (items[i].CodeType == \u0027ClassRoomG\u0027 \u0026\u0026 items[i].CodeId == \u0027NUN\u0027 \u0026\u0026 !isClassRooms) {\n                        isClassRooms = true;\n\n                    }\n\n                    //console.log(items[i]);\n                    if (items[i].CodeType == \u0027LESSON\u0027 \u0026\u0026 items[i].CodeType != \u0027UNIT\u0027) {\n                        isLesson = true;\n                    }\n\n                    if (items[i].CodeType)\n                        className = items[i].CodeType \u002B \u0022CURR\u0022;\n\n                }\n\n                var listOptions = \u0027\u003Cdiv id=\u0022levelrelatedData_\u0027 \u002B level \u002B \u0027\u0022 class=\u0022col-lg-12 col-md-12 col-sm-12 col-xs-12 form-group\u0022\u003E\u0027 \u002B\n                    \u0027\u003Clabel class=\u0022control-label col-md-2\u0022\u003E\u003C/label\u003E\u0027 \u002B\n                    \u0027\u003Cdiv class=\u0022col-lg-6 col-md-6 col-sm-12 col-xs-12\u0022\u003E\u0027 \u002B\n                    \u0027\u003Cselect style=\u0022direction:rtl\u0022 \u0027;\n\n                //if list of ClassRooms , then no need to trigger the event\n                if (!isClassRooms \u0026\u0026 !isLesson)\n                    listOptions = listOptions \u002B \u0027onchange=\u0022return relatedDataDrawTrees(\u0027 \u002B level \u002B \u0027,this.value);\u0022 \u0027;\n                else\n                    listOptions = listOptions \u002B \u0027onchange=\u0022return LessonIconView(\u0027 \u002B level \u002B \u0027,this.value);\u0022 \u0027;\n\n                listOptions = listOptions \u002B \u0027class=\u0022form-control select2 selectedrelatedDataTrees \u0027;\n\n                if (isLesson)\n                    listOptions = listOptions \u002B \u0027relatedDataLesson notTree \u0027;\n\n                listOptions = listOptions \u002B \u0027  \u0027 \u002B className;\n                if (!isClassRooms \u0026\u0026 !isLesson \u0026\u0026 value != null) {\n\n                    listOptions = listOptions \u002B \u0027 \u0022 id=\u0022SelectedrelatedDataTrees_\u0027 \u002B level \u002B \u0027\u0022 name=\u0022SelectedrelatedDataTrees_\u0027 \u002B level \u002B \u0027\u0022\u003E\u0027 \u002B ddItems \u002B \u0027\u003C/select\u003E \u003C/div\u003E\u003Cdiv class=\u0022col-lg-1 col-md-1 col-sm-12 col-xs-12\u0022\u003E \u0027 \u002B\n\n                        \u0027\u003C/div\u003E\u0027 \u002B\n                        \u0027\u003Cspan class=\u0022col-lg-3 col-md-3 col-sm-12 col-xs-12 text-danger treeError\u0022\u003E\u003C/span\u003E\u003C/div\u003E\u0027;\n                }\n                else {\n                    if (value != null) {\n                        listOptions = listOptions \u002B \u0027 \u0022 id=\u0022SelectedrelatedDataTrees_\u0027 \u002B level \u002B \u0027\u0022 name=\u0022SelectedrelatedDataTrees_\u0027 \u002B level \u002B \u0027\u0022\u003E\u0027 \u002B ddItems \u002B \u0027\u003C/select\u003E  \u003C/div\u003E\u003Cdiv class=\u0022col-lg-1 col-md-1 col-sm-12 col-xs-12\u0022\u003E\u0027 \u002B\n\n                            \u0027\u003C/div\u003E\u0027 \u002B\n                            \u0027\u003Cspan class=\u0022col-lg-3 col-md-3 col-sm-12 col-xs-12 text-danger treeError\u0022\u003E\u003C/span\u003E\u003C/div\u003E\u0027;\n                    } else {\n                        listOptions = listOptions \u002B \u0027 \u0022 id=\u0022SelectedrelatedDataTrees_\u0027 \u002B level \u002B \u0027\u0022 name=\u0022SelectedrelatedDataTrees_\u0027 \u002B level \u002B \u0027\u0022\u003E\u0027 \u002B ddItems \u002B \u0027\u003C/select\u003E  \u003C/div\u003E\u003Cdiv class=\u0022col-lg-1 col-md-1 col-sm-12 col-xs-12\u0022\u003E \u0027 \u002B\n\n                            \u0027\u003C/div\u003E\u0027 \u002B\n                            \u0027\u003Cspan class=\u0022col-lg-3 col-md-3 col-sm-12 col-xs-12 text-danger treeError\u0022\u003E\u003C/span\u003E\u003C/div\u003E\u0027;\n                    }\n\n                }\n\n                $(\u0022#relatedDataTrees\u0022).append(listOptions);\n\n                if (isLesson) {\n                    $(\u0022.relatedDataLesson\u0022).attr(\u0022multiple\u0022, \u0022multiple\u0022);\n                    $(\u0022.relatedDataLesson\u0022).select2();\n                }\n            }\n            else {\n                document.getElementById(\u0027hfRelatedDataLevelsCount\u0027).value = level - 1;\n\n            }\n        }\n\n\n        function GetCheildOfSubject() { \n            var lengthTress = $(\u0022.selectedrelatedDataTrees\u0022).length; \n\n            var output = 0;\n            for (let index = 0; index \u003C lengthTress; index\u002B\u002B) {\n                if ($(\u0022.selectedrelatedDataTrees\u0022).eq(index).val() != undefined \u0026\u0026 $(\u0022.selectedrelatedDataTrees\u0022).eq(index).val() != \u0027\u0027 \u0026\u0026\n                    $(\u0022.selectedrelatedDataTrees\u0022).eq(index).val() != null \u0026\u0026 $(\u0022.selectedrelatedDataTrees\u0022).eq(index).val() != \u0027\u0627\u062E\u062A\u0631\u0027 \u0026\u0026 Array.isArray($(\u0022.selectedrelatedDataTrees\u0022).eq(index).val()) == false) {\n                    output = $(\u0022.selectedrelatedDataTrees\u0022).eq(index).val();\n                } \n            }\n            if (output == 0) {\n                output = $(\u0022#relatedDataselectedUnitId\u0022).val();\n            }\n            return output;\n        }\n\n\n        function GetLessonSelected() {  ;\n            if ($(\u0022#userSelectedLesson\u0022).val() !== \u0027\u0027) {\n            \n\n                if ($(\u0022.relatedDataLesson\u0022).val() == \u0027\u0027) {\n                    var list = $(\u0022#userSelectedLesson\u0022).val();\n                    var str_array = list.split(\u0027,\u0027);\n\n                    var result = new Array();\n                    for (var i = 0; i \u003C str_array.length; i\u002B\u002B) {\n                        // Trim the excess whitespace.\n                        str_array[i] = str_array[i].replace(/^\\s*/, \u0022\u0022).replace(/\\s*$/, \u0022\u0022);\n                        result.push(str_array[i]);\n                    }\n\n                    return result;\n                }\n\n            }\n            return $(\u0022.relatedDataLesson\u0022).val();\n        }\n\n       \n        $(document.body).on(\u0022change\u0022, \u0022.relatedDataLesson\u0022, function () {\n         \n            $(\u0022.relatedDataLesson\u0022).val(GetLessonSelected());\n        });\n\n\n    \u003C/script\u003E\n\n\n\n                    \u003C/div\u003E\n                    \u003Ca onclick=\u0022searchActivitesList();\u0022 class=\u0022btn btn-primary\u0022\u003E\n                        \u003Ci class=\u0022fa-solid fa-search me-2\u0022\u003E\u003C/i\u003E\n                        \u0628\u062D\u062B\n                    \u003C/a\u003E\n                \u003C/div\u003E\n            \u003C/div\u003E\n            \u003Cdiv id=\u0022divSearchActivitesResultId\u0022\u003E\n            \u003C/div\u003E\n            \u003Cdiv class=\u0022pagination pagination-spaced d-flex justify-content-center mt-3\u0022 id=\u0022ActivitesPaginationId\u0022\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n        \u003Cdiv class=\u0022card-footer py-0 px-3\u0022\u003E\n            \u003Cdiv class=\u0022back-btn\u0022\u003E\n                \u003Cbutton id=\u0022backButton\u0022 onclick=\u0022showhidedivs(\u0027secondPage\u0027, \u0027mainPage\u0027);\u0022 class=\u0022btn btn-primary px-3 my-3 mx-2\u0022\u003E \u003Ci class=\u0022fa-solid fa-chevron-left mx-2\u0022\u003E\u003C/i\u003E \u0639\u0648\u062F\u0629    \u003C/button\u003E\n            \u003C/div\u003E\n        \u003C/div\u003E\n    \u003C/div\u003E\n    \n\u003C/div\u003E\n\u003Cscript type=\u0022text/javascript\u0022\u003E\n    var lectureActivitiesList  = \u0027\u0027;\n    var selectedUnitId  = \u0027277\u0027;\n    var treeId  = \u002727564\u0027;\n    var schoolId = \u0027E7F07D5AB1E7A8BAA59F6FC2BA80190B\u0027;\n    var getActivitiesListUrl = \u0027/Teacher/LectureTools/GetActivitiesList\u0027;\n    var timeTableId = \u002774928820\u0027;\n    var eventDataModel = \\u0027;\n    \u003C/script\u003E\n\u003Cscript src=\u0022https://vstedu.azureedge.net/v27/src/teacher/lecturetools/addactivity.js?v=14\u0022\u003E\u003C/script\u003E\n"}